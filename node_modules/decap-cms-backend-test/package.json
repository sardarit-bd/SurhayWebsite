{
  "name": "decap-cms-backend-test",
  "description": "Development testing backend for Decap CMS",
  "version": "3.5.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/decaporg/decap-cms/tree/main/packages/decap-cms-backend-test"
  },
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "license": "MIT",
  "module": "dist/esm/index.js",
  "main": "dist/decap-cms-backend-test.js",
  "keywords": [
    "decap-cms",
    "backend"
  ],
  "sideEffects": false,
  "dependencies": {
    "path-browserify": "^1.0.1"
  },
  "peerDependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "lodash": "^4.17.11",
    "prop-types": "^15.7.2",
    "react": "^19.1.0",
    "uuid": "^8.3.2",
    "decap-cms-ui-default": "3.9.4",
    "decap-cms-lib-util": "3.9.1"
  },
  "browser": {
    "path": "path-browserify"
  },
  "scripts": {
    "develop": "pnpm run build:esm --watch",
    "build": "cross-env NODE_ENV=production webpack",
    "build:esm": "cross-env NODE_ENV=esm babel src --out-dir dist/esm --ignore \"**/__tests__\" --root-mode upward --extensions \".js,.jsx,.ts,.tsx\""
  }
}