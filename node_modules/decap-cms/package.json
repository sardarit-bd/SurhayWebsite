{
  "name": "decap-cms",
  "description": "An extensible, open source, Git-based, React CMS for static sites.",
  "version": "3.17.1",
  "homepage": "https://www.decapcms.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/decaporg/decap-cms"
  },
  "bugs": "https://github.com/decaporg/decap-cms/issues",
  "main": "dist/decap-cms.js",
  "keywords": [
    "cms",
    "content editing",
    "static site generators",
    "jamstack"
  ],
  "license": "MIT",
  "dependencies": {
    "codemirror": "^5.46.0",
    "create-react-class": "^15.7.0",
    "file-loader": "^6.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "svgo-loader": "^3.0.3",
    "decap-cms-app": "3.17.1",
    "decap-cms-media-library-cloudinary": "3.1.5",
    "decap-cms-media-library-s3": "0.2.1",
    "decap-cms-media-library-uploadcare": "3.1.3"
  },
  "incrementToForceBump": 2,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 webpack",
    "build-preview": "cross-env NODE_ENV=production webpack serve --open",
    "develop": "webpack serve --hot"
  }
}