generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Inquiry {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  name        String
  email       String
  nachricht   String
  paket       String
  leistung    String[]
  telefon     String?
  unternehmen String?
  sprache     String
  status      String   @default("new") 
  note        String?
  @@index([status])
  @@index([createdAt])
}

model ConfiguratorRequest {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  typ           String
  extras        String[]
  wartung       String
  konfiguration String 
  name          String
  email         String
  anmerkungen   String?
  rawData       Json
  status        String   @default("new")
  note          String?
  @@index([status])
  @@index([createdAt])
}

model Setting {
  id    String @id @default("global")
  key   String @unique
  value String
}
model Admin {
  id           String   @id @default(cuid())
  username     String   @unique @default("admin")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}