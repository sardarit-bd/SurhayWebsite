",null,{"property":"og:url","content":"https://surhay.design/tr/sss/"}],["$","meta",null,{"property":"og:image","content":"https://surhay.design/og-default.png"}],["$","meta",null,{"property":"og:locale","content":"tr_TR"}],[["$","meta","de",{"property":"og:locale:alternate","content":"de_DE"}],["$","meta","en",{"property":"og:locale:alternate","content":"en_GB"}]],["$","meta",null,{"name":"twitter:card","content":"summary_large_image"}],["$","meta",null,{"name":"twitter:title","content":"Web tasarım, fiyat ve süreç hakkında sık sorulan sorular | Surhay Design"}],["$","meta",null,{"name":"twitter:description","content":"Maliyet, süreç, teknik, bakım, yenileme ve hukuk hakkındaki tüm sorular — konuya göre sıralanmış ve aranabilir."}],["$","meta",null,{"name":"twitter:image","content":"https://surhay.design/og-default.png"}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"@id\":\"https://surhay.design/#business\",\"name\":\"Surhay Design\",\"description\":\"KOBİ’ler, serbest çalışanlar ve girişimler için özel tasarlanmış, hızlı web siteleri. Berlin’den web tasarım, geliştirme ve bakım — ölçülebilir biçimde daha iyi.\",\"url\":\"https://surhay.design\",\"email\":\"hallo@surhay.design\",\"image\":\"https://surhay.design/og-default.png\",\"priceRange\":\"€€\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Berlin\",\"addressCountry\":\"DE\"},\"areaServed\":[\"DE\",\"AT\",\"CH\"],\"sameAs\":[\"https://www.linkedin.com/company/surhay-design\",\"https://www.instagram.com/surhay.design\",\"https://github.com/surhay\"],\"knowsAbout\":[\"Webdesign\",\"Webentwicklung\",\"SEO\",\"Website-Wartung\"]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],"$L3","$L4","$L5","$L6","$L7"],"$L8"],["$L9","$La","$Lb"],"$Lc"]}],"isPartial":"$@d","staleTime":"$e","varyParams":null},{"rsc":"$Lf","isPartial":"$@10","staleTime