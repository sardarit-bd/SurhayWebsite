1d:T76e,{"@context":"https://schema.org","@type":"Service","name":"Bakım & destek","serviceType":"Bakım & destek","description":"Siteniz için bakım paketleri: güncellemeler, güvenlik izleme, günlük yedekler, erişilebilirlik kontrolü, içerik bakımı ve sabit bir muhatap. Aylık iptal edilebilir.","provider":{"@type":"ProfessionalService","name":"Surhay Design","url":"https://surhay.design"},"areaServed":["DE","AT","CH"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Bakım & destek","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Güncellemeler & bağımlılıklar","description":"Kullanılan tüm kütüphaneler güncel tutulur ve güncellemeden sonra kontrol edilir — körlemesine kurulup en iyisi umulmaz."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Güvenlik & izleme","description":"Bilinen açıklar otomatik olarak bildirilir ve değerlendirilir. Güvenlik açısından kritik olanları sormadan kapatır, sonrasında size haber veririz."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Yedekler","description":"30 günlük geçmişle günlük yedek ve üç ayda bir geri yükleme testi. Hiç geri yüklenmemiş bir yedek, yedek değildir."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Erişilebilirlik kontrolü","description":"Dakikalık kontrol. Site düşerse bunu sizden önce biz öğreniriz — ve müşteriden gelen bir sürpriz yerine bizden bir mesaj alırsınız."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"İçerik bakımı","description":"Pakete göre aylık bir kontenjan: metin değişiklikleri, yeni görseller ya da ek bir alt sayfa. Siz bir e-posta yazarsınız, biz yaparız."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Sabit muhatap","description":"Bilet numarası yok, bekleme sırası yok. Bir iş günü içinde yanıt, site kesintisinde hemen."}}]}}2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1d"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Sizin yapmadığınız siteleri de devralıyor musunuz?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Evet, bir durum tespitinden sonra. Tek seferlik 290 € tutar ve işletmenin gerçekçi maliyetini gösterir. Site sorumluluğunu alamayacağımız bir hâldeyse bunu söyler, yalnızca durum tespitini faturalarız.\"}},{\"@type\":\"Question\",\"name\":\"Taahhüt süresine bağlı mıyım?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Hayır. Tüm paketler ay sonunda iptal edilebilir. Asgari süre, bir gün gitmek isteyeceğinize oynanan bir bahis olurdu — o zaman zaten başka bir şey yolunda değildir.\"}},{\"@type\":\"Question\",\"name\":\"Sitem gece çökerse ne olur?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"İzleme kesintiyi anında bildirir. Hafta içi birkaç saat içinde, mesai dışında ertesi sabah müdahale ederiz. Gerçek 7/24 nöbet gerekiyorsa, tek başımıza tutamayacağımız bir söz yerine dürüst bir tavsiye alırsınız.\"}}]}"}}]]
