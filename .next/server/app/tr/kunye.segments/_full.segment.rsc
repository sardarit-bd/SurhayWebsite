17:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"@id\":\"https://surhay.design/#business\",\"name\":\"Surhay Design\",\"description\":\"KOBİ’ler, serbest çalışanlar ve girişimler için özel tasarlanmış, hızlı web siteleri. Berlin’den web tasarım, geliştirme ve bakım — ölçülebilir biçimde daha iyi.\",\"url\":\"https://surhay.design\",\"email\":\"hallo@surhay.design\",\"image\":\"https://surhay.design/og-default.png\",\"priceRange\":\"€€\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Berlin\",\"addressCountry\":\"DE\"},\"areaServed\":[\"DE\",\"AT\",\"CH\"],\"sameAs\":[\"https://www.linkedin.com/company/surhay-design\",\"https://www.instagram.com/surhay.design\",\"https://github.com/surhay\"],\"knowsAbout\":[\"Webdesign\",\"Webentwicklung\",\"SEO\",\"Website-Wartung\"]}"}}]
