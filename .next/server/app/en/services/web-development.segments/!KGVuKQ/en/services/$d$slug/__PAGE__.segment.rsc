1d:T789,{"@context":"https://schema.org","@type":"Service","name":"Web Development","serviceType":"Web Development","description":"High-performance web development without a site builder: statically generated pages, a CMS you maintain yourself, bilingual routing, accessibility and sub-second load times.","provider":{"@type":"ProfessionalService","name":"Surhay Design","url":"https://surhay.design"},"areaServed":["DE","AT","CH"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Web Development","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Statically generated site","description":"Pre-rendered HTML instead of a database query per visit. This shrinks the attack surface compared with database-driven systems and reduces possible runtime failure points. Hosting, scripts, forms and dependencies still need ongoing upkeep."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"A CMS you maintain yourself","description":"An editing area where you change copy, images, blog posts and case studies yourself — without us and without HTML."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Bilingual by construction","description":"German and English as equal page trees with their own URLs, hreflang markup and a language switch — not a translation plugin."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Forms & integrations","description":"Contact and enquiry forms with spam protection, optionally wired into your CRM, calendar or newsletter."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Accessibility","description":"Semantic HTML, keyboard operation, visible focus, a correct heading hierarchy and alt text. Verified, not claimed."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Handover & documentation","description":"Source code, credentials and a short guide are yours. Even if the collaboration ends, the website stays yours."}}]}}1e:T4a2,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Do I get WordPress?","acceptedAnswer":{"@type":"Answer","text":"Usually not. For a company site of 5 to 15 pages WordPress is oversized and turns into a maintenance burden. If your team already operates it confidently, or you need a shop, we say so openly in the first call."}},{"@type":"Question","name":"Can I really edit content myself?","acceptedAnswer":{"@type":"Answer","text":"Yes. Copy, images, blog posts, case studies and FAQ entries run through an editing area with form fields and a preview. After saving, the site rebuilds itself in a minute or two."}},{"@type":"Question","name":"Who owns the code?","acceptedAnswer":{"@type":"Answer","text":"You do. After the final invoice you receive the full repository and all credentials. There is no licence tying you to us."}},{"@type":"Question","name":"What happens to my existing domain and email addresses?","acceptedAnswer":{"@type":"Answer","text":"We move the domain without your email going down — mailboxes stay untouched. Old URLs get 301 redirects so neither search engines nor partners who linked to you hit a dead end."}}]}2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1d"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1e"}}]]
