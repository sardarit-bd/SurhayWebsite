1e:T6fb,{"@context":"https://schema.org","@type":"Service","name":"Web Design","serviceType":"Web Design","description":"Custom web design for SMEs, freelancers and startups: structure, typography and conversion logic instead of a template. A clickable draft before the first line of code.","provider":{"@type":"ProfessionalService","name":"Surhay Design","url":"https://surhay.design"},"areaServed":["DE","AT","CH"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Web Design","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Structure & site plan","description":"Which pages exist, in what order they argue, and where the contact path sits — written down before anything is designed."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Clickable draft","description":"Your homepage and key subpages as a working prototype at desktop and mobile widths. You click through it before any code exists."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Design system","description":"Colours with measured contrast ratios, a type scale, spacing, buttons and form fields. Decided once, applied everywhere."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Copy scaffold","description":"Headlines, subheadings and calls to action written out in the draft — no lorem ipsum you cannot judge anything by."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Responsive behaviour","description":"How every section behaves between 320 and 2560 pixels is part of the draft, not something discovered during the build."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Accessibility from the draft on","description":"Contrast, focus states, type sizes and operating order are settled in design, not patched in afterwards."}}]}}2:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1e"}}]
3:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do I get several design options to choose from?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No — one, and a reasoned one. Three options means two of them were made without conviction. Instead you get two revision rounds on that single draft.\"}},{\"@type\":\"Question\",\"name\":\"Can I keep my brand, logo and colours?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. If a corporate design exists, we work inside it. If not, a lean design system of colour, type and spacing emerges that can grow into a brand later.\"}},{\"@type\":\"Question\",\"name\":\"What if I do not like the draft?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"That is what the two revision rounds are for. If they do not land, the project ends after the design phase — you pay for the work done and keep the draft. A design that does not convince you will not convince your customers either.\"}}]}"}}]
