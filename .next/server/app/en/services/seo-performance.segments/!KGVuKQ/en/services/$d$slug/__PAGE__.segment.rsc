1d:T77a,{"@context":"https://schema.org","@type":"Service","name":"SEO & Performance","serviceType":"SEO & Performance","description":"Technical SEO and load-time optimisation: Core Web Vitals in the green, clean structured data, a deliberate keyword structure and measurable visibility instead of promises.","provider":{"@type":"ProfessionalService","name":"Surhay Design","url":"https://surhay.design"},"areaServed":["DE","AT","CH"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"SEO & Performance","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Technical foundation","description":"Sitemap, robots.txt, clean URLs, canonicals, hreflang, 301 redirects and indexable legal pages. The basics most sites fail on."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Core Web Vitals","description":"LCP, CLS and INP are measured and optimised — not estimated. Target: green on mobile, not only in a desktop test."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Structured data","description":"Markup for organisation, services, articles, FAQ and breadcrumbs in schema.org format. So Google understands your page rather than merely reading it."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Keyword and page structure","description":"Which page answers which search intent is decided before writing. One page per intent — never two competing with each other."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Local visibility","description":"Setting up and maintaining the Google Business Profile, consistent company data and local landing pages when your customers come from the region."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Reporting you can actually read","description":"Search Console and privacy-friendly analytics without a cookie banner. On request, a monthly two-paragraph report instead of a 40-page PDF."}}]}}2:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$1d"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do you guarantee position 1 on Google?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No, and nobody can do so credibly. What we do commit to: a technically sound site, a reasoned keyword structure and measurable numbers. Anyone guaranteeing you position 1 is selling you a ranking for a term nobody searches for.\"}},{\"@type\":\"Question\",\"name\":\"How long until SEO works?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Technical improvements take days to weeks. Content visibility on competitive terms takes three to six months, often longer. Anyone telling you otherwise is planning your budget around their revenue.\"}},{\"@type\":\"Question\",\"name\":\"Do I need a cookie banner for analytics?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not with a cookie-free setup such as Plausible or a correspondingly configured Matomo install. It is legally cleaner and costs you none of the visitors who click banners away.\"}}]}"}}]]
