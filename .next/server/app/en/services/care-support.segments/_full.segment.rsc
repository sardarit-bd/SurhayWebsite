e:T6d9,{"@context":"https://schema.org","@type":"Service","name":"Care & Support","serviceType":"Care & Support","description":"Care plans for your website: updates, security monitoring, daily backups, uptime checks, content edits and a named contact. Cancel monthly.","provider":{"@type":"ProfessionalService","name":"Surhay Design","url":"https://surhay.design"},"areaServed":["DE","AT","CH"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Care & Support","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Updates & dependencies","description":"Every library in use is kept current and checked after the update — not applied blindly and hoped for."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Security & monitoring","description":"Known vulnerabilities are reported automatically and assessed. Security-critical holes we close without asking first and tell you afterwards."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Backups","description":"Daily backups with 30 days of history and a restore test every quarter. A backup never restored is not a backup."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Uptime checks","description":"Checked every minute. If the site goes down we know before you do — and you get a message rather than a surprise from a customer."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Content edits","description":"Depending on the plan, an allowance of copy changes, new images or one extra subpage per month. You send an email, we do it."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"A named contact","description":"No ticket number, no hold music. A reply within one working day, and immediately if the site is down."}}]}}4:[["$","meta",null,{"httpEquiv":"Content-Security-Policy","content":"default-src 'self'; base-uri 'self'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'uns