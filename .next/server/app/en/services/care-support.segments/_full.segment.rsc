f:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do you take over websites you did not build?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, after an inventory. It costs €290 once and shows what running the site realistically costs. If the site is in a state we cannot take responsibility for, we say so — and bill only the inventory.\"}},{\"@type\":\"Question\",\"name\":\"Am I tied into a term?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. All plans can be cancelled at the end of any month. A minimum term would be a bet that you will eventually want to leave — in which case something else is wrong.\"}},{\"@type\":\"Question\",\"name\":\"What if my site goes down at night?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Monitoring reports it immediately. On working days we react within a few hours, outside business hours the next morning. If you genuinely need 24/7 standby, you get an honest recommendation from us rather than a promise we cannot keep alone.\"}}]}"}}]
