30:["$","section","ablauf",{"id":"ablauf","data-group":"ablauf","className":"faq-group scroll-mt-28","children":[["$","div",null,{"data-reveal":"","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2","children":[["$","h2",null,{"className":"h3","children":"Process & timing","data-c-faq-page":""}],null],"data-c-faq-page":""}],["$","p",null,{"className":"mt-3 max-w-2xl text-mute","children":"How a project runs, how long it takes, and where it most often stalls.","data-c-faq-page":""}]],"data-c-faq-page":""}],["$","div",null,{"className":"mt-7","data-faq-rows":"","data-reveal":"","children":[[["$","div","How long does a website project take?",{"className":"faq-item","style":{"--i":"0"},"children":[["$","h3",null,{"className":"faq-head","children":["$","button",null,{"type":"button","id":"faq-ablauf-0-q","className":"faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 text-left font-display font-semibold tracking-tight py-5 text-[1.05rem] md:text-lg","aria-expanded":"false","aria-controls":"faq-ablauf-0-p","children":[["$","span",null,{"className":"flex items-baseline gap-4","children":[false,["$","span",null,{"children":"How long does a website project take?"}]]}],["$","span",null,{"className":"faq-icon","aria-hidden":"true","children":["$","span",null,{"className":"faq-glyph","children":[["$","span",null,{"className":"faq-bar faq-bar-v"}],["$","span",null,{"className":"faq-bar faq-bar-h"}]]}]}]]}]}],["$","div",null,{"className":"faq-panel","id":"faq-ablauf-0-p","role":"region","aria-labelledby":"faq-ablauf-0-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>A one-pager typically goes live after 3–4 weeks, a multi-page website after 5–7 weeks. The most common cause of delays is missing content, by the way — which is why we sort out copy and imagery right at the start.</p>"}}]}]]}],["$","div","What do you need from me to get started?",{"className":"faq-item","style":{"--i":"1"},"children":[["$","h3",null,{"className":"faq-head","children":["$","button",null,{"type":"button","id":"faq-ablauf-1-q","className":"faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 text-left font-display font-semibold tracking-tight py-5 text-[1.05rem] md:text-lg","aria-expanded":"false","aria-controls":"faq-ablauf-1-p","children":[["$","span",null,{"className":"flex items-baseline gap-4","children":[false,["$","span",null,{"children":"What do you need from me to get started?"}]]}],["$","span",null,{"className":"faq-icon","aria-hidden":"true","children":["$","span",null,{"className":"faq-glyph","children":[["$","span",null,{"className":"faq-bar faq-bar-v"}],["$","span",null,{"className":"faq-bar faq-bar-h"}]]}]}]]}]}],["$","div",null,{"className":"faq-panel","id":"faq-ablauf-1-p","role":"region","aria-labelledby":"faq-ablauf-1-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>Three things: an idea of what the website should achieve, one contact on your side who is allowed to decide — and your content. Copy and images are the most common reason projects run longer than planned. If they are missing we say so early and can take on the copywriting as an add-on.</p>"}}]}]]}],["$","div","How many revision rounds are included?",{"className":"faq-item","style":{"--i":"2"},"children":[["$","h3",null,{"className":"faq-head","children":["$","button",null,{"type":"button","id":"faq-ablauf-2-q","className":"faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 text-left font-display font-semibold tracking-tight py-5 text-[1.05rem] md:text-lg","aria-expanded":"false","aria-controls":"faq-ablauf-2-p","children":[["$","span",null,{"className":"flex items-ba