2c:["$","div",null,{"className":"faq-panel","id":"faq-preise-2-p","role":"region","aria-labelledby":"faq-preise-2-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>Domain and hosting keep running — you pay those directly to your provider, not through us. On top of that there is an optional care plan from €49 a month and add-ons you can book individually. Without a care plan, nothing recurring is owed to us. What your project needs to stay online is named in the quote.</p>"}}]}]
2d:["$","div","How and when do I pay?",{"className":"faq-item","style":{"--i":"3"},"children":[["$","h3",null,{"className":"faq-head","children":["$","button",null,{"type":"button","id":"faq-preise-3-q","className":"faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 text-left font-display font-semibold tracking-tight py-5 text-[1.05rem] md:text-lg","aria-expanded":"false","aria-controls":"faq-preise-3-p","children":[["$","span",null,{"className":"flex items-baseline gap-4","children":[false,["$","span",null,{"children":"How and when do I pay?"}]]}],["$","span",null,{"className":"faq-icon","aria-hidden":"true","children":["$","span",null,{"className":"faq-glyph","children":[["$","span",null,{"className":"faq-bar faq-bar-v"}],["$","span",null,{"className":"faq-bar faq-bar-h"}]]}]}]]}]}],["$","div",null,{"className":"faq-panel","id":"faq-preise-3-p","role":"region","aria-labelledby":"faq-preise-3-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>In three steps: 40 % on order, 30 % once you sign off the design, 30 % at launch. Invoices arrive at exactly those three points, with no timesheets in between. All prices are net, plus VAT where applicable.</p>"}}]}]]}]
2e:["$","div","What happens when something is added mid-project?",{"className":"faq-item","style":{"--i":"4"},"children":[["$","h3",null,{"className":"faq-head","children":["$","button",null,{"type":"button","id":"faq-preise-4-q","className":"faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 text-left font-display font-semibold tracking-tight py-5 text-[1.05rem] md:text-lg","aria-expanded":"false","aria-controls":"faq-preise-4-p","children":[["$","span",null,{"className":"flex items-baseline gap-4","children":[false,["$","span",null,{"children":"What happens when something is added mid-project?"}]]}],["$","span",null,{"className":"faq-icon","aria-hidden":"true","children":["$","span",null,{"className":"faq-glyph","children":[["$","span",null,{"className":"faq-bar faq-bar-v"}],["$","span",null,{"className":"faq-bar faq-bar-h"}]]}]}]]}]}],["$","div",null,{"className":"faq-panel","id":"faq-preise-4-p","role":"region","aria-labelledby":"faq-preise-4-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>We quote it before we build it. The fixed price covers the scope stated in the quote; anything beyond that comes back to you as a short addendum with a price and its effect on the schedule. You then decide whether it belongs in this project or in a later round.</p>"}}]}]]}]
