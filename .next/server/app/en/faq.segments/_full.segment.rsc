4c:["$","div",null,{"className":"faq-panel","id":"faq-technik-2-p","role":"region","aria-labelledby":"faq-technik-2-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>The website runs at a provider of your choice; we set the hosting up and hand over every credential. Domain, source code, content and access belong to you — including in the case where we stop working together. No contract ties your site to us.</p>"}}]}]
