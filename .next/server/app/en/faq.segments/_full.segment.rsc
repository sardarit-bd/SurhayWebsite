launch, without SEO losses.</p>"}}]}]]}],["$","div","Will a relaunch cost me my Google rankings?",{"className":"faq-item","style":{"--i":"1"},"children":[["$","h3",null,{"className":"faq-head","children":["$","button",null,{"type":"button","id":"faq-bestand-1-q","className":"faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 text-left font-display font-semibold tracking-tight py-5 text-[1.05rem] md:text-lg","aria-expanded":"false","aria-controls":"faq-bestand-1-p","children":[["$","span",null,{"className":"flex items-baseline gap-4","children":[false,["$","span",null,{"children":"Will a relaunch cost me my Google rankings?"}]]}],["$","span",null,{"className":"faq-icon","aria-hidden":"true","children":["$","span",null,{"className":"faq-glyph","children":[["$","span",null,{"className":"faq-bar faq-bar-v"}],["$","span",null,{"className":"faq-bar faq-bar-h"}]]}]}]]}]}],["$","div",null,{"className":"faq-panel","id":"faq-bestand-1-p","role":"region","aria-labelledby":"faq-bestand-1-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>Not if the move is prepared. We record the existing URLs, set up redirects to the new ones, and keep an eye on the titles, descriptions and content of the pages that bring visitors today. After launch we watch Search Console — small fluctuations in the first weeks are normal, a drop is not.</p>"}}]}]]}],["$","div","Does my domain or email address have to move?",{"className":"faq-item","style":{"--i":"2"},"children":[["$","h3",null,{"className":"faq-head","children":["$","button",null,{"type":"button","id":"faq-bestand-2-q","className":"faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 text-left font-display font-semibold tracking-tight py-5 text-[1.05rem] md:text-lg","aria-expanded":"false","aria-controls":"faq-bestand-2-p","children":[["$","span",null,{"className":"flex items-baseline gap-4","children":[false,["$","span",null,{"children":"Does my domain or email address have to move?"}]]}],"$L53"]}]}],"$L54"]}],"$L55"],"$L56"],"data-c-faq-page":""}]],"data-c-faq-page":""}]
