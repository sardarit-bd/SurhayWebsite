47:["$","div",null,{"className":"faq-panel","id":"faq-zusammenarbeit-2-p","role":"region","aria-labelledby":"faq-zusammenarbeit-2-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>It takes 30 to 45 minutes, costs nothing, and ends with one of two answers: a quote with a fixed price, or an honest recommendation of where else to go. We go through your goal, the scope and the budget. No sales pitch, and no follow-up emails afterwards.</p>"}}]}]
48:["$","div","Do you build online shops or large portals?",{"className":"faq-item","style":{"--i":"3"},"children":[["$","h3",null,{"className":"faq-head","children":["$","button",null,{"type":"button","id":"faq-zusammenarbeit-3-q","className":"faq-trigger flex w-full cursor-pointer items-center justify-between gap-6 text-left font-display font-semibold tracking-tight py-5 text-[1.05rem] md:text-lg","aria-expanded":"false","aria-controls":"faq-zusammenarbeit-3-p","children":[["$","span",null,{"className":"flex items-baseline gap-4","children":[false,["$","span",null,{"children":"Do you build online shops or large portals?"}]]}],["$","span",null,{"className":"faq-icon","aria-hidden":"true","children":["$","span",null,{"className":"faq-glyph","children":[["$","span",null,{"className":"faq-bar faq-bar-v"}],["$","span",null,{"className":"faq-bar faq-bar-h"}]]}]}]]}]}],["$","div",null,{"className":"faq-panel","id":"faq-zusammenarbeit-3-p","role":"region","aria-labelledby":"faq-zusammenarbeit-3-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>Not large shops with thousands of items — there are specialists for that, and we would rather refer you than build something we do not want to look after long-term. A website with a small catalogue or a booking flow is workable. What else we do not take on is stated openly on the studio page.</p>"}}]}]]}]
