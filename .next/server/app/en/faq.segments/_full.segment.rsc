42:["$","div",null,{"className":"faq-panel","id":"faq-ablauf-2-p","role":"region","aria-labelledby":"faq-ablauf-2-q","suppressHydrationWarning":true,"children":["$","div",null,{"className":"faq-panel-inner prose max-w-none pb-6 pr-14 text-mute","style":{"fontSize":"0.96rem"},"dangerouslySetInnerHTML":{"__html":"<p>Two in design, included in the fixed price. A round means you collect your notes and hand them back in one go, and we work them in. The limit is deliberate — unlimited rounds rarely produce better drafts, only drafts without a point of view.</p>"}}]}]
