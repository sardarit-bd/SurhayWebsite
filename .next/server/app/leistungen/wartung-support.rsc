14:T786,{"@context":"https://schema.org","@type":"Service","name":"Wartung & Support","serviceType":"Wartung & Support","description":"Wartungspakete für Ihre Website: Updates, Sicherheits-Monitoring, tägliche Backups, Verfügbarkeitsprüfung, Inhaltspflege und fester Ansprechpartner. Monatlich kündbar.","provider":{"@type":"ProfessionalService","name":"Surhay Design","url":"https://surhay.design"},"areaServed":["DE","AT","CH"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Wartung & Support","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Updates & Abhängigkeiten","description":"Alle eingesetzten Bibliotheken werden aktuell gehalten und nach dem Update geprüft — nicht blind eingespielt und gehofft."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Sicherheit & Monitoring","description":"Bekannte Schwachstellen werden automatisiert gemeldet und bewertet. Sicherheitskritische Lücken schließen wir ohne Rückfrage und informieren Sie danach."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Backups","description":"Tägliche Sicherung mit 30 Tagen Historie und einem Wiederherstellungstest pro Quartal. Ein Backup, das nie zurückgespielt wurde, ist kein Backup."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Verfügbarkeitsprüfung","description":"Prüfung im Minutentakt. Fällt die Seite aus, erfahren wir es vor Ihnen — und Sie bekommen eine Nachricht, keine Überraschung vom Kunden."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Inhaltspflege","description":"Je nach Paket ein Kontingent an Textänderungen, neuen Bildern oder einer zusätzlichen Unterseite pro Monat. Sie schreiben eine E-Mail, wir machen es."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Fester Ansprechpartner","description":"Keine Ticketnummer, keine Warteschleife. Antwort innerhalb eines Werktags, bei Ausfall der Seite sofort."}}]}}15:T471,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Übernehmen Sie auch Websites, die Sie nicht gebaut haben?","acceptedAnswer":{"@type":"Answer","text":"Ja, nach einer Bestandsaufnahme. Sie kostet einmalig 290 € und zeigt, was der Betrieb realistisch kostet. Ist die Seite in einem Zustand, in dem wir sie nicht verantworten können, sagen wir das — und rechnen nur die Bestandsaufnahme ab."}},{"@type":"Question","name":"Bin ich an eine Laufzeit gebunden?","acceptedAnswer":{"@type":"Answer","text":"Nein. Alle Pakete sind zum Monatsende kündbar. Eine Mindestlaufzeit wäre eine Wette darauf, dass Sie irgendwann gehen wollen — dann stimmt etwas anderes nicht."}},{"@type":"Question","name":"Was passiert, wenn meine Seite nachts ausfällt?","acceptedAnswer":{"@type":"Answer","text":"Das Monitoring meldet den Ausfall sofort. Werktags reagieren wir innerhalb weniger Stunden, außerhalb der Geschäftszeiten am nächsten Morgen. Wer echte Rund-um-die-Uhr-Bereitschaft braucht, bekommt von uns eine ehrliche Empfehlung statt eines Versprechens, das wir allein nicht halten können."}}]}e:[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$14"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$15"}}]]
