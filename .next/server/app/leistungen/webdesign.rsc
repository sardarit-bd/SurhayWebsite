e:T76b,{"@context":"https://schema.org","@type":"Service","name":"Webdesign","serviceType":"Webdesign","description":"Individuelles Webdesign für KMU, Selbstständige und Startups: Struktur, Typografie und Conversion-Logik statt Template. Klickbarer Entwurf vor der ersten Zeile Code.","provider":{"@type":"ProfessionalService","name":"Surhay Design","url":"https://surhay.design"},"areaServed":["DE","AT","CH"],"hasOfferCatalog":{"@type":"OfferCatalog","name":"Webdesign","itemListElement":[{"@type":"Offer","itemOffered":{"@type":"Service","name":"Struktur & Seitenplan","description":"Welche Seiten es gibt, in welcher Reihenfolge sie argumentieren und wo der Kontaktweg liegt — schriftlich, bevor gestaltet wird."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Klickbarer Entwurf","description":"Ihre Startseite und die wichtigsten Unterseiten als bedienbarer Prototyp in Desktop- und Mobilbreite. Sie klicken sich durch, bevor Code entsteht."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Designsystem","description":"Farben mit geprüften Kontrastwerten, eine Typo-Skala, Abstände, Schaltflächen und Formularfelder. Alles einmal entschieden, überall gleich."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Textgerüst","description":"Überschriften, Zwischenüberschriften und Handlungsaufforderungen im Entwurf ausformuliert — kein Blindtext, an dem sich nichts beurteilen lässt."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Responsives Verhalten","description":"Wie sich jede Sektion zwischen 320 und 2560 Pixeln verhält, ist Teil des Entwurfs — nicht etwas, das später beim Bauen herauskommt."}},{"@type":"Offer","itemOffered":{"@type":"Service","name":"Barrierefreiheit ab Entwurf","description":"Kontraste, Fokuszustände, Schriftgrößen und Bedienreihenfolge werden im Design festgelegt, nicht nachträglich repariert."}}]}}4:[["$","meta",null,{"httpEquiv":"Content-Security-Policy","content":"default-src 'self'; base-uri 'self'; object-sr